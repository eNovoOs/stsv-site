# Webhooks eNovoOs — une URL par formulaire.
# À définir dans Vercel → Settings → Environment Variables (jamais dans le dépôt).
STSV_WEBHOOK_CONTACT="https://api.platform.osenovo.com/work-flow/hooks/.../webhook-trigger/..."
STSV_WEBHOOK_NEWSLETTER="https://api.platform.osenovo.com/work-flow/hooks/.../webhook-trigger/..."

# Optionnel : envoyé dans l'en-tête X-STSV-Signature pour authentifier l'appel
STSV_WEBHOOK_SECRET=""
