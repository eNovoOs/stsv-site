---
/**
 * En-tête de page interne, repris de stsv.ca :
 * - avec image : bandeau photo arrondi, titre blanc centré par-dessus
 * - sans image : titre et chapô centrés sur fond blanc
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: 'blue' | 'light';
}
const { title, lead, image, imageAlt = '' } = Astro.props;
---

{image ? (
  <section class="phero phero--media">
    <div class="wrap">
      <div class="phero__frame">
        <Image src={image} alt={imageAlt} widths={[800, 1200, 1600]} sizes="(min-width: 1440px) 1380px, 100vw" loading="eager" fetchpriority="high" />
        <div class="phero__overlay"></div>
        <h1>{title}</h1>
      </div>
      {lead && <p class="phero__lead phero__lead--under">{lead}</p>}
      <slot name="cta" />
    </div>
  </section>
) : (
  <section class="phero phero--plain">
    <div class="wrap">
      <h1>{title}</h1>
      {lead && <p class="phero__lead">{lead}</p>}
      <slot name="cta" />
    </div>
  </section>
)}

<style>
  .phero--media { padding-top: var(--sp-5); }
  .phero__frame {
    position: relative; display: grid; border-radius: var(--radius-hero);
    overflow: hidden; min-height: 250px;
  }
  .phero__frame > :global(img) {
    grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .phero__overlay { grid-area: 1 / 1; background: rgba(10, 22, 44, .42); }
  .phero__frame h1 {
    grid-area: 1 / 1; position: relative; z-index: 1; margin: 0;
    color: var(--white); text-align: center; align-self: center; justify-self: center;
    padding: var(--sp-6) var(--sp-5);
  }
  @media (min-width: 900px) { .phero__frame { min-height: 300px; } }

  .phero--plain { padding-block: var(--sp-7) var(--sp-2); text-align: center; }
  .phero--plain h1 { margin-bottom: var(--sp-4); }
  .phero__lead {
    font-size: 1rem; color: var(--gray-600); margin: 0 auto; max-width: 62ch; line-height: 1.6;
  }
  .phero__lead--under { margin-top: var(--sp-5); text-align: left; max-width: var(--wrap-text); }
</style>
