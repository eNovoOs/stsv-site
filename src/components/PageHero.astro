---
/**
 * En-tête de page interne, repris de stsv.ca :
 * - avec image : bandeau photo arrondi, titre blanc centré par-dessus
 * - sans image : titre et chapô centrés sur fond blanc
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * Hauteur du point d'intérêt dans la photo, en pourcentage depuis le haut.
   * Le cadre étant plus large que la plupart des sources, l'image est rognée
   * en haut et en bas : cette valeur décide de ce qui reste. Baisser le
   * chiffre remonte le cadrage — utile quand les visages sont hauts.
   */
  focus?: number;
  tone?: 'blue' | 'light';
}
const { title, lead, image, imageAlt = '', focus = 42 } = Astro.props;
---

{image ? (
  <section class="phero phero--media">
    <div class="wrap">
      <div class="phero__frame" style={`--focus:${focus}%`}>
        <Image src={image} alt={imageAlt} widths={[800, 1200, 1600]} sizes="(min-width: 1440px) 1380px, 100vw" loading="eager" fetchpriority="high" />
        <div class="phero__overlay"></div>
        <h1>{title}</h1>
      </div>
      {lead && <p class="phero__lead phero__lead--under">{lead}</p>}
      <slot name="cta" />
    </div>
  </section>
) : (
  <section class="phero phero--band">
    <div class="wrap">
      <div class="phero__frame phero__frame--band">
        <h1>{title}</h1>
      </div>
      {lead && <p class="phero__lead phero__lead--under">{lead}</p>}
      <slot name="cta" />
    </div>
  </section>
)}

<style>
  .phero--media { padding-top: var(--sp-5); }

  /* Le bandeau impose sa forme, jamais l'inverse.
     Les photos sources vont du portrait (0.89) au panoramique (2.59) : sans
     ratio fixe, chaque page hériterait d'une hauteur différente. L'image est
     recadrée par object-fit, le cadre reste identique partout. */
  .phero__frame {
    position: relative; display: grid; place-items: center;
    border-radius: var(--radius-hero); overflow: hidden;
    aspect-ratio: 3 / 2;
    min-height: 220px;
  }

  /* La photo et le voile sont hors flux : ils habillent le cadre sans peser
     sur sa hauteur. Tant qu'ils restaient des éléments de grille, la rangée
     adoptait la hauteur naturelle de l'image — 1054 px pour une photo 16/9
     dans un cadre de 720 — et le titre se centrait par rapport à elle, donc
     trop bas. C'est la raison pour laquelle la variante sans photo, elle,
     tombait juste. */
  .phero__frame > :global(img),
  .phero__overlay {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .phero__frame > :global(img) {
    object-fit: cover; object-position: center var(--focus, 42%); display: block;
  }
  .phero__overlay { background: rgba(10, 22, 44, .42); }

  .phero__frame h1 {
    position: relative; z-index: 1; margin: 0;
    color: var(--white); text-align: center;
    padding: var(--sp-6) var(--sp-5); text-wrap: balance;
  }

  @media (min-width: 700px) { .phero__frame { aspect-ratio: 2 / 1; } }
  /* 2.6/1 est la proportion de la page « Transport adapté », prise comme
     référence : c'est celle dont le rendu a été validé. */
  @media (min-width: 900px) {
    .phero__frame { aspect-ratio: 2.6 / 1; min-height: 300px; }
  }

  /* Pages sans photo : même cadre, même hauteur, fond de marque.
     L'en-tête garde ainsi la même forme d'une page à l'autre, que la STSV
     dispose ou non d'une image pour le sujet traité. */
  .phero--band { padding-top: var(--sp-5); }
  .phero__frame--band {
    background: var(--blue);
    background-image:
      radial-gradient(ellipse 70% 120% at 12% 0%, rgba(69, 195, 207, .34), transparent 62%),
      radial-gradient(ellipse 60% 130% at 92% 108%, rgba(189, 209, 0, .20), transparent 60%);
    place-items: center;
  }
  .phero__frame--band h1 {
    color: var(--white); text-align: center; margin: 0;
    padding: var(--sp-6) var(--sp-5); text-wrap: balance;
  }

  .phero__lead {
    font-size: 1rem; color: var(--gray-600); margin: 0 auto; max-width: 62ch; line-height: 1.6;
  }
  .phero__lead--under { margin-top: var(--sp-5); text-align: left; max-width: var(--wrap-text); }
</style>
