---
/** En-tête de page interne : titre noir sur fond blanc, comme sur stsv.ca. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: 'blue' | 'light';
}
const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---
<section class="phero">
  <div class="wrap">
    {image && (
      <div class="phero__media">
        <Image src={image} alt={imageAlt} widths={[800, 1200, 1600]} sizes="(min-width: 1440px) 1380px, 100vw" loading="eager" />
      </div>
    )}
    {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="phero__lead">{lead}</p>}
    <slot name="cta" />
  </div>
</section>
<style>
  .phero { padding-block: var(--sp-6) var(--sp-2); }
  .phero__media { border-radius: var(--radius-hero); overflow: hidden; margin-bottom: var(--sp-6); }
  .phero__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 21 / 7; }
  .phero__eyebrow {
    margin: 0 0 .4rem; font-size: .72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .1em; color: var(--gray-500);
  }
  .phero h1 { margin-bottom: var(--sp-3); }
  .phero__lead { font-size: 1.02rem; color: var(--gray-600); max-width: var(--wrap-text); margin: 0; }
</style>
