---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Form from './Form.astro';
import hero from '../assets/images/hero-contact.jpg';
import { useTranslations, type Locale } from '../i18n/ui';
import { contactPage as c, adapted } from '../data/content';
import { contact } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Base locale={locale} page="contact" title={c.meta.title[locale]} description={c.meta.description[locale]}>
  <PageHero
    title={c.h1[locale]}
    lead={c.lead[locale]}
    image={hero}
    focus={60}
    imageAlt={{
      fr: 'Une agente portant un casque d’écoute répond à un appel',
      en: 'An agent wearing a headset answering a call',
      es: 'Una agente con auriculares atiende una llamada',
    }[locale]}
  />

  <section class="section">
    <div class="wrap ct">
      <div class="ct__info">
        <div class="card">
          <h2>{c.phoneTitle[locale]}</h2>
          <a class="phone mono" href={contact.phoneHref}>{contact.phoneDisplay}</a>
          <h3 class="h-sm">{c.hoursTitle[locale]}</h3>
          <ul class="hours mono">{c.hours[locale].map((h) => <li>{h}</li>)}</ul>
        </div>
        <div class="card">
          <h2>{c.adaptedTitle[locale]}</h2>
          <p>{c.adaptedBody[locale]}</p>
          <ul class="mails">
            {adapted.emails.map((e) => <li><a class="mono" href={`mailto:${e}`}>{e}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="ct__form">
        <h2>{c.formTitle[locale]}</h2>
        <Form locale={locale} kind="contact" />
      </div>
    </div>
  </section>
</Base>
<style>
  .ct { display: grid; gap: var(--sp-6); align-items: start; }
  .ct__info { display: grid; gap: var(--sp-4); }
  .card h2 { font-size: var(--step-1); margin-bottom: var(--sp-3); }
  .phone { display: inline-block; font-size: var(--step-2); font-weight: 700; color: var(--blue); text-decoration: none; margin-bottom: var(--sp-4); }
  .phone:hover { text-decoration: underline; }
  .h-sm { font-size: var(--step-0); margin-bottom: var(--sp-2); }
  .hours { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font-size: var(--step--1); color: var(--gray-600); }
  .mails { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; }
  @media (min-width: 900px) { .ct { grid-template-columns: 1fr 1.3fr; gap: var(--sp-7); } }
</style>
