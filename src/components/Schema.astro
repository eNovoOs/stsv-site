---
/**
 * Données structurées schema.org.
 * TransitAgency sur toutes les pages, FAQPage et BreadcrumbList au besoin.
 */
import { contact, territory, communobusHours, fares } from '../data/site';
import { htmlLang, path, type Locale, type RouteKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: RouteKey;
  pageTitle: string;
  pageDescription: string;
  faq?: { question: string; answer: string }[];
}
const { locale, page, pageTitle, pageDescription, faq } = Astro.props;
const origin = (Astro.site ?? new URL('https://stsv.ca')).origin;
const url = new URL(path(page, locale), origin).href;

const agency = {
  '@type': 'TransitAgency',
  '@id': `${origin}/#organization`,
  name: 'Société de transport de Salaberry-de-Valleyfield',
  alternateName: 'STSV',
  url: origin,
  logo: `${origin}/brand/logo-stsv.png`,
  image: `${origin}/brand/og-${locale}.png`,
  telephone: '+1-450-370-0600',
  email: 'ta@stsv.ca',
  slogan: {
    fr: 'Votre trajet commence ici',
    en: 'Your journey starts here',
    es: 'Tu viaje comienza aquí',
  }[locale],
  description: {
    fr: `Transport collectif, Communobus sur réservation et transport adapté. ${communobusHours.fr}`,
    en: `Public transit, Communobus by reservation and adapted transportation. ${communobusHours.en}`,
    es: `Transporte colectivo, Communobus con reserva y transporte adaptado. ${communobusHours.es}`,
  }[locale],
  areaServed: [...new Set([...territory.collective, ...territory.adapted])].map((name) => ({
    '@type': 'City',
    name,
    addressRegion: 'QC',
    addressCountry: 'CA',
  })),
  sameAs: [contact.facebook],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+1-450-370-0600',
      contactType: 'reservations',
      availableLanguage: ['French', 'English', 'Spanish'],
      hoursAvailable: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '06:30',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Saturday',
          opens: '09:00',
          closes: '17:00',
        },
      ],
    },
    /* Le transport adapté a sa propre ligne. Sans ce second point de contact,
       les moteurs et les assistants ne connaissent que celle du collectif et
       orientent tout le monde au même endroit. Pas d'horaire déclaré ici : la
       STSV ne nous l'a pas transmis. */
    {
      '@type': 'ContactPoint',
      telephone: '+1-450-370-0155',
      contactType: 'reservations',
      name: { fr: 'Transport adapté', en: 'Adapted transportation', es: 'Transporte adaptado' }[locale],
      email: 'ta@stsv.ca',
      availableLanguage: ['French', 'English', 'Spanish'],
    },
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    name: { fr: 'Faire une réservation', en: 'Make a reservation', es: 'Hacer una reserva' }[locale],
    target: contact.bookingUrl,
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: origin,
  name: 'STSV',
  inLanguage: htmlLang[locale],
  publisher: { '@id': `${origin}/#organization` },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: pageTitle,
  description: pageDescription,
  inLanguage: htmlLang[locale],
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#organization` },
};

/* Fil d'Ariane : accueil + page courante (le site est à un seul niveau) */
const breadcrumb =
  page === 'home'
    ? null
    : {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: { fr: 'Accueil', en: 'Home', es: 'Inicio' }[locale],
            item: new URL(path('home', locale), origin).href,
          },
          { '@type': 'ListItem', position: 2, name: pageTitle, item: url },
        ],
      };

const faqNode = faq?.length
  ? {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

/* Tarifs déclarés uniquement sur la page des services */
const offers =
  page === 'services'
    ? {
        '@type': 'Offer',
        '@id': `${url}#tarifs`,
        name: { fr: 'Titres de transport', en: 'Transit fares', es: 'Títulos de transporte' }[locale],
        priceCurrency: 'CAD',
        offeredBy: { '@id': `${origin}/#organization` },
        priceSpecification: fares.flatMap((table) =>
          table.rows.map((row) => ({
            '@type': 'PriceSpecification',
            name: `${table.title[locale]} — ${row.label[locale]}`,
            price: row.regular.replace(/[^\d,]/g, '').replace(',', '.'),
            priceCurrency: 'CAD',
          })),
        ),
      }
    : null;

const graph = [agency, website, webpage, breadcrumb, faqNode, offers].filter(Boolean);
const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
