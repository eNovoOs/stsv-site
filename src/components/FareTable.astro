---
import type { FareTable, L10n } from '../data/site';
import { fareHeadings } from '../data/site';
import type { Locale } from '../i18n/ui';
interface Props { table: FareTable; locale: Locale; caption?: string }
const { table, locale, caption } = Astro.props;
const hasReduced = table.rows.some((r) => r.reduced);
---
<div class="fare">
  <h3 class="fare__title">{table.title[locale]}</h3>
  {caption && <p class="fare__caption">{caption}</p>}
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">{fareHeadings.label[locale]}</th>
          <th scope="col" class="num">{fareHeadings.regular[locale]}</th>
          {hasReduced && <th scope="col" class="num">{fareHeadings.reduced[locale]}</th>}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((r) => (
          <tr>
            <th scope="row">{r.label[locale]}</th>
            <td class="num">{r.regular}</td>
            {hasReduced && <td class="num">{r.reduced ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
<style>
  .fare { margin-bottom: var(--sp-6); }
  .fare__title { font-size: var(--step-1); margin-bottom: var(--sp-2); }
  .fare__caption { font-size: var(--step--1); color: var(--gray-600); margin-bottom: var(--sp-3); }
  tbody th { font-weight: 500; }
</style>
