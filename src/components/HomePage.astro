---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { useTranslations, path, type Locale } from '../i18n/ui';
import { contact, banner, isExpired, todayUTC } from '../data/site';

import heroImg from '../assets/images/hero-valleyfield.jpg';
import cardLignes from '../assets/images/card-lignes-fixes.jpg';
import cardAdapte from '../assets/images/card-transport-adapte.jpg';
import cardCommunobus from '../assets/images/card-communobus.jpg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* Trois visuels de service : image + libellé dessous, comme sur stsv.ca */
const services = [
  {
    img: cardLignes,
    label: { fr: 'Lignes Fixes', en: 'Fixed Lines', es: 'Líneas Fijas' }[locale],
    href: path('services', locale),
    alt: {
      fr: 'Un minibus de la ligne 10 stationné au bord de l’eau',
      en: 'A line 10 minibus parked by the water',
      es: 'Un minibús de la línea 10 estacionado junto al agua',
    }[locale],
  },
  {
    img: cardAdapte,
    label: { fr: 'Transport Adapté', en: 'Adapted Transportation', es: 'Transporte Adaptado' }[locale],
    href: path('adapted', locale),
    alt: {
      fr: 'Une chauffeuse accompagne une usagère en fauteuil roulant vers un véhicule adapté',
      en: 'A driver helps a passenger in a wheelchair board an adapted vehicle',
      es: 'Una conductora acompaña a una usuaria en silla de ruedas hacia un vehículo adaptado',
    }[locale],
  },
  {
    img: cardCommunobus,
    label: 'Communobus',
    href: path('reservation', locale),
    alt: {
      fr: 'Un usager consulte son téléphone à côté d’un véhicule Communobus',
      en: 'A passenger checks their phone next to a Communobus vehicle',
      es: 'Un usuario consulta su teléfono junto a un vehículo Communobus',
    }[locale],
  },
];

/* Liens rapides : pastilles avec icône, reprises du site d'origine */
const quick = [
  { label: t('nav.adapted'), href: path('adapted', locale), icon: 'bus' },
  { label: 'Communobus', href: contact.bookingUrl, icon: 'car', external: true },
  { label: { fr: 'Documents', en: 'Documents', es: 'Documentos' }[locale], href: path('documents', locale), icon: 'doc' },
  { label: t('nav.tutorials'), href: path('tutorials', locale), icon: 'play' },
  { label: t('cta.call'), href: contact.phoneHref, icon: 'phone' },
];

const heroAlt = {
  fr: 'Vue aérienne de Salaberry-de-Valleyfield et de son pont',
  en: 'Aerial view of Salaberry-de-Valleyfield and its bridge',
  es: 'Vista aérea de Salaberry-de-Valleyfield y su puente',
}[locale];
---

<Base locale={locale} page="home" title={t('home.title')} description={t('home.description')}>
  <section class="hero">
    <div class="wrap">
      <div class="hero__frame">
        <Image
          class="hero__img"
          src={heroImg}
          alt={heroAlt}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 1440px) 1380px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__overlay"></div>
        <div class="hero__content">
          <h1>{t('home.heroTitle')}</h1>
          <p class="hero__lead">{t('home.heroLead')}</p>
          <div class="hero__cta">
            <a class="btn btn--glass" href={contact.bookingUrl} target="_blank" rel="noopener">{t('cta.bookLong')}</a>
            <a class="btn btn--glass" href={path('services', locale)}>{t('cta.fares')}</a>
          </div>
        </div>
      </div>

      {banner.active && !isExpired(banner, todayUTC()) && (
        <p class="hero__alert" data-until={banner.until}>
          <span class="hero__alert-tag">{banner.eyebrow[locale]}</span>
          {banner.title[locale]}
        </p>
      )}
    </div>
  </section>

  <section class="section services">
    <div class="wrap">
      <h2>{t('home.servicesEyebrow')}</h2>
      <ul class="services__grid">
        {services.map((s) => (
          <li>
            <a class="svc" href={s.href}>
              <span class="svc__media">
                <Image src={s.img} alt={s.alt} widths={[440, 660]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
              </span>
              <span class="svc__label">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section quick">
    <div class="wrap">
      <h2>{t('home.quickLinks')}</h2>
      <ul class="quick__grid">
        {quick.map((q) => (
          <li>
            <a class="pill" href={q.href} {...(q.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="pill__icon" aria-hidden="true">
                {q.icon === 'bus' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 11h16M7 21v-2M17 21v-2"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/></svg>}
                {q.icon === 'car' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l1.5-5A2 2 0 0 1 8.4 6.5h7.2a2 2 0 0 1 1.9 1.5L19 13M4 13h16v5H4z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="16.5" cy="18" r="1.5"/></svg>}
                {q.icon === 'doc' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>}
                {q.icon === 'play' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5z" fill="currentColor" stroke="none"/></svg>}
                {q.icon === 'phone' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.8 2.1z"/></svg>}
              </span>
              {q.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero : image plein cadre, texte centré ---------- */
  .hero { padding-top: var(--sp-5); }
  .hero__frame {
    position: relative; border-radius: var(--radius-hero); overflow: hidden;
    min-height: 420px; display: grid;
  }
  .hero__frame > :global(.hero__img) {
    grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .hero__overlay {
    grid-area: 1 / 1;
    background: linear-gradient(180deg, rgba(10, 22, 44, .34) 0%, rgba(10, 22, 44, .52) 100%);
  }
  .hero__content {
    grid-area: 1 / 1; position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: var(--sp-8) var(--sp-5);
  }
  .hero h1 { color: var(--white); margin-bottom: var(--sp-3); max-width: none; text-wrap: balance; }
  .hero__lead {
    color: rgba(255, 255, 255, .94); font-size: 1.06rem; margin: 0 0 var(--sp-5); max-width: 62ch;
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); justify-content: center; }
  .btn--glass {
    background: rgba(255, 255, 255, .18);
    border: 1px solid rgba(255, 255, 255, .45);
    color: var(--white);
    backdrop-filter: blur(6px);
    min-width: 210px;
  }
  .btn--glass:hover { background: rgba(255, 255, 255, .95); color: var(--ink-900); border-color: transparent; }

  .hero__alert {
    margin: var(--sp-4) 0 0; text-align: center;
    font-size: .88rem; color: var(--gray-600);
    display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; justify-content: center;
  }
  .hero__alert-tag {
    font-family: var(--font-mono); font-size: .62rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: .1em;
    background: var(--lime); color: var(--black); padding: .15rem .45rem; border-radius: 4px;
  }

  /* ---------- Services : image + libellé dessous ---------- */
  .services h2, .quick h2 { margin-bottom: var(--sp-5); }
  .services__grid, .quick__grid { list-style: none; margin: 0; padding: 0; }
  .services__grid { display: grid; gap: var(--sp-5); }
  @media (min-width: 760px) { .services__grid { grid-template-columns: repeat(3, 1fr); } }

  .svc { display: block; text-decoration: none; color: inherit; }
  .svc__media { display: block; border-radius: var(--radius-lg); overflow: hidden; background: var(--gray-100); }
  .svc__media :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    aspect-ratio: 443 / 614; transition: transform .4s ease;
  }
  .svc:hover .svc__media :global(img) { transform: scale(1.03); }
  .svc__label {
    display: block; margin-top: var(--sp-3);
    font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--ink-900);
  }
  .svc:hover .svc__label { color: var(--blue); }

  /* ---------- Liens rapides : pastilles ---------- */
  .quick__grid { display: grid; gap: var(--sp-3); }
  @media (min-width: 620px) { .quick__grid { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); } }
  .pill {
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    padding: .85rem 1.2rem; min-height: 52px;
    background: var(--white); border: 1px solid #E3E8F0; border-radius: 10px;
    font-size: .88rem; font-weight: 500; color: var(--ink-900); text-decoration: none;
    transition: border-color .15s ease, color .15s ease, box-shadow .15s ease;
  }
  .pill:hover { border-color: var(--blue); color: var(--blue); box-shadow: var(--shadow-sm); }
  .pill__icon { display: inline-flex; color: var(--gray-500); }
  .pill:hover .pill__icon { color: var(--blue); }

  @media (min-width: 900px) {
    .hero__frame { min-height: 500px; }
    .hero__content { padding-inline: var(--sp-8); }
  }
</style>
