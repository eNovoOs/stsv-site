---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { useTranslations, path, type Locale } from '../i18n/ui';
import { contact, notices, lines, communobusHours } from '../data/site';

import heroImg from '../assets/images/hero-accueil.jpg';
import cardLignes from '../assets/images/card-lignes-fixes.jpg';
import cardCommunobus from '../assets/images/card-communobus.jpg';
import cardAdapte from '../assets/images/card-transport-adapte.jpg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const live = notices.filter((n) => n.active);

const services = [
  {
    img: cardLignes,
    title: { fr: 'Lignes fixes', en: 'Fixed lines', es: 'Líneas fijas' }[locale],
    body: {
      fr: 'Trois lignes relient le centre-ville, le Cégep, l’hôpital, le parc industriel et la gare de Vaudreuil.',
      en: 'Three lines connect downtown, the Cégep, the hospital, the industrial park and the Vaudreuil station.',
      es: 'Tres líneas conectan el centro, el Cégep, el hospital, el parque industrial y la estación de Vaudreuil.',
    }[locale],
    href: path('services', locale),
  },
  {
    img: cardCommunobus,
    title: 'Communobus',
    body: {
      fr: `Transport collectif à la demande, sur réservation. ${communobusHours.fr}`,
      en: `On-demand public transit, by reservation. ${communobusHours.en}`,
      es: `Transporte colectivo a demanda, con reserva. ${communobusHours.es}`,
    }[locale],
    href: path('reservation', locale),
  },
  {
    img: cardAdapte,
    title: { fr: 'Transport adapté', en: 'Adapted transportation', es: 'Transporte adaptado' }[locale],
    body: {
      fr: 'Service dédié aux personnes à mobilité réduite, avec formulaires d’admission et guide de l’usager.',
      en: 'A service for people with reduced mobility, with eligibility forms and a user guide.',
      es: 'Servicio para personas con movilidad reducida, con formularios de admisión y guía del usuario.',
    }[locale],
    href: path('adapted', locale),
  },
];

const heroAlt = {
  fr: 'Un autobus de la STSV en service à Salaberry-de-Valleyfield',
  en: 'An STSV bus in service in Salaberry-de-Valleyfield',
  es: 'Un autobús de la STSV en servicio en Salaberry-de-Valleyfield',
}[locale];

const lineLabel = { fr: 'Ligne', en: 'Line', es: 'Línea' }[locale];
const linesTitle = { fr: 'Nos lignes', en: 'Our lines', es: 'Nuestras líneas' }[locale];
const cardCta = { fr: 'En savoir plus', en: 'Learn more', es: 'Saber más' }[locale];
---

<Base locale={locale} page="home" title={t('home.title')} description={t('home.description')}>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">STSV</p>
        <h1>{t('home.heroTitle')}</h1>
        <p class="hero__lead">{t('home.heroLead')}</p>
        <div class="hero__cta">
          <a class="btn btn--light" href={contact.bookingUrl} target="_blank" rel="noopener">{t('cta.bookLong')}</a>
          <a class="btn btn--outline-light" href={path('services', locale)}>{t('cta.fares')}</a>
        </div>
      </div>
      <div class="hero__media">
        <Image src={heroImg} alt={heroAlt} widths={[520, 760, 1100]} sizes="(min-width: 960px) 50vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  {live.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="visually-hidden">{t('home.noticesTitle')}</h2>
        <div class="grid grid--2">
          {live.map((n) => (
            <article class="card notice">
              <p class="eyebrow">{n.eyebrow[locale]}</p>
              <h3>{n.title[locale]}</h3>
              <p>{n.body[locale]}</p>
              {n.ctaHref && n.ctaLabel && (
                <a class="notice__cta" href={n.ctaHref}>
                  {n.ctaLabel[locale]}
                  <span class="tag-pdf">{t('a11y.pdf')}</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--air">
    <div class="wrap">
      <p class="eyebrow">{t('home.servicesEyebrow')}</p>
      <div class="grid grid--3 svc">
        {services.map((s) => (
          <a class="svc__card" href={s.href}>
            <span class="svc__media">
              <Image src={s.img} alt="" widths={[380, 560]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
            </span>
            <span class="svc__body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <span class="svc__more">{cardCta}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{linesTitle}</h2>
      <ul class="lines">
        {lines.map((l) => (
          <li class="card line">
            <span class="line__num mono">{lineLabel} {l.number}</span>
            <div>
              <h3 class="line__name">{l.name[locale]}</h3>
              <p class="line__route">{l.route[locale]}</p>
              <p class="line__freq">{l.frequency[locale]}</p>
            </div>
            <a class="btn btn--ghost line__btn" href={l.schedule}>{t('cta.schedule')}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section newsletter">
    <div class="wrap newsletter__inner">
      <div>
        <h2 class="newsletter__title">{t('newsletter.hook')}</h2>
        <p class="newsletter__lead">{t('newsletter.cta')}</p>
      </div>
      <a class="btn btn--lime" href={path('newsletter', locale)}>{t('newsletter.cta')}</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--blue); color: var(--white); overflow: hidden; }
  .hero__grid { display: grid; gap: var(--sp-6); align-items: center; padding-block: var(--sp-7); }
  .hero__eyebrow { color: var(--cyan-on-blue); }
  .hero h1 { color: var(--white); max-width: 15ch; }
  .hero__lead { font-size: var(--step-1); max-width: 42ch; color: rgba(255, 255, 255, 0.92); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-5); }
  .hero__media { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }
  .hero__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }
  .btn--outline-light { background: transparent; color: var(--white); border-color: rgba(255, 255, 255, 0.55); }
  .btn--outline-light:hover { background: var(--white); color: var(--blue); border-color: var(--white); }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1fr 1fr; gap: var(--sp-7); padding-block: var(--sp-8); }
  }

  .notice h3 { margin-bottom: var(--sp-2); }
  .notice p { margin-bottom: var(--sp-4); }
  .notice__cta { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; text-decoration: none; }
  .notice__cta:hover { text-decoration: underline; }
  .tag-pdf {
    font-family: var(--font-mono); font-size: .65rem; letter-spacing: .08em;
    background: var(--gray-100); color: var(--gray-600); padding: .1rem .35rem; border-radius: 4px;
  }

  .svc__card {
    display: flex; flex-direction: column; text-decoration: none; color: inherit;
    background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius-lg);
    overflow: hidden; box-shadow: var(--shadow-sm);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .svc__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .svc__media { display: block; }
  .svc__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .svc__body { display: block; padding: var(--sp-5); }
  .svc__card h3 { color: var(--blue); margin-bottom: var(--sp-2); }
  .svc__card p { margin: 0 0 var(--sp-4); font-size: var(--step--1); color: var(--gray-600); }
  .svc__more { font-weight: 600; font-size: var(--step--1); color: var(--blue); }
  .svc__card:hover .svc__more { text-decoration: underline; }

  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .line { display: grid; gap: var(--sp-3); align-items: start; }
  .line__num {
    display: inline-block; background: var(--blue); color: var(--white);
    font-weight: 700; font-size: var(--step--1); padding: .3rem .7rem; border-radius: 6px; justify-self: start;
  }
  .line__name { margin-bottom: .3rem; font-size: var(--step-1); }
  .line__route { margin-bottom: .3rem; font-size: var(--step--1); color: var(--gray-600); }
  .line__freq { margin: 0; font-size: var(--step--1); }
  .line__btn { justify-self: start; }
  @media (min-width: 820px) {
    .line { grid-template-columns: 130px 1fr auto; align-items: center; gap: var(--sp-5); }
    .line__btn { justify-self: end; }
  }

  .newsletter__inner {
    background: var(--black); color: var(--white); border-radius: var(--radius-lg);
    padding: var(--sp-6); display: grid; gap: var(--sp-5); align-items: center;
  }
  .newsletter__title { color: var(--white); margin-bottom: .3rem; font-size: var(--step-3); }
  .newsletter__lead { margin: 0; color: rgba(255, 255, 255, 0.85); }
  @media (min-width: 760px) { .newsletter__inner { grid-template-columns: 1fr auto; padding: var(--sp-7); } }
</style>
